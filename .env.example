# Copie este arquivo para ".env" e preencha com um token do Meta Marketing API
# (System User Token) com permissao ads_read para as contas Goalfy, Hapo Educacao
# e Hapo Assessoria. Gerado em business.facebook.com > Configuracoes do negocio >
# Usuarios do sistema > Gerar novo token.
META_ACCESS_TOKEN=

# Porta do servidor local (opcional)
PORT=8787

# Chave da API do Google Gemini (aistudio.google.com/apikey), usada para gerar
# a analise estrategica "visao do gestor de trafego" na aba Insights.
GEMINI_API_KEY=

# Modelo do Gemini (opcional)
GEMINI_MODEL=gemini-2.5-flash
